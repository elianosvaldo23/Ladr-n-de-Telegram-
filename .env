# Token del Bot de Telegram
BOT_TOKEN=8243952025:AAGBsFfvTTkTKvjYO1POSiEyma2OdKmmGH8

# ID del Administrador (puede configurar el userbot)
ADMIN_ID=1742433244

# Usuarios Premium (IDs separados por comas)
PREMIUM_USERS=1742433244

# Configuración de Ambiente
ENVIRONMENT=development
PORT=8080

# MongoDB Configuration
MONGODB_URI=mongodb+srv://Ladron:Ladron@cluster0.izg1pgu.mongodb.net/?appName=Cluster0

# Directorio temporal para descargas.
# IMPORTANTE: Debe estar en una partición con espacio SUFICIENTE (>2 GB libre).
# Por defecto usa ./tmp (relativo al directorio del bot).
# En Pterodactyl VPS:
#   - NO usar /tmp (partición pequeña, ~1 GB)
#   - NO usar /home/user (puede ser read-only)
#   - RECOMENDADO: /home/container/tmp o dejar vacío (usa ./tmp)
# TEMP_DOWNLOAD_DIR=

# Canal intermedio: el userbot sube aquí y el bot reenvía al usuario.
# El bot debe ser admin con permisos completos en este canal.
INTERMEDIATE_CHANNEL_ID=-1003807861240

# Máximo de descargas/transferencias simultáneas
# Con 3+ uploads concurrentes, Pyrogram acumula FloodWaits que causan timeouts.
# 2 es óptimo: permite concurrencia sin saturar la sesión de Pyrogram.
MAX_CONCURRENT_TRANSFERS=2

# Límite de disco del servidor en GB
SERVER_DISK_LIMIT_GB=4.88

# Reserva mínima de disco para el sistema (en MB)
DISK_RESERVE_MB=500

# NOTA: Las credenciales del userbot (API_ID, API_HASH, PHONE_NUMBER)
# ahora se configuran desde el bot usando el menú de configuración.
# Ya no es necesario definirlas aquí.
